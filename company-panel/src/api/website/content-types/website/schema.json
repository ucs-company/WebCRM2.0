{
  "kind": "collectionType",
  "collectionName": "websites",
  "info": {
    "singularName": "website",
    "pluralName": "websites",
    "displayName": "Website",
    "description": "An NGO website managed from the panel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "domain": {
      "type": "string"
    },
    "logo": {
      "type": "media",
      "allowedTypes": ["images"],
      "multiple": false
    },
    "admins": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "admin::user"
    },
    "pages": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page",
      "mappedBy": "website"
    }
  }
}
